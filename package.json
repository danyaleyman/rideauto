{
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.0"
  },
  "scripts": {
    "generate:seo-landings": "node scripts/generate-seo-landings.mjs",
    "lint:js": "npm --prefix web run lint",
    "lh:ci": "lhci autorun --config=web/lighthouserc.desktop.cjs && lhci autorun --config=web/lighthouserc.mobile.cjs",
    "lh:ci:desktop": "lhci autorun --config=web/lighthouserc.desktop.cjs",
    "lh:ci:mobile": "lhci autorun --config=web/lighthouserc.mobile.cjs",
    "test:e2e": "playwright test --grep-invert \"@visual\"",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.js",
    "test:e2e:funnel": "playwright test e2e/lead-funnel.spec.js e2e/b2c-features.spec.js",
    "test:e2e:staging": "playwright test",
    "test:e2e:visual": "playwright test e2e/visual.spec.js e2e/visual-mobile.spec.js",
    "test:unit": "npm --prefix web run test:unit"
  }
}
