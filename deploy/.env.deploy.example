# Конфиг удалённых операций RideAuto (deploy/ops). Скопируйте в deploy/.env.deploy
# (gitignored) и заполните. НИКОГДА не коммитьте реальные значения.
#
#   cp deploy/.env.deploy.example deploy/.env.deploy

# Адрес и доступ к серверу
RIDEAUTO_DEPLOY_HOST=
RIDEAUTO_DEPLOY_USER=root
RIDEAUTO_DEPLOY_PORT=22

# Аутентификация — задайте ОДНО из двух:
# 1) приватный ключ (рекомендуется):
RIDEAUTO_DEPLOY_SSH_KEY=
# 2) или пароль (менее безопасно):
RIDEAUTO_DEPLOY_SSH_PASSWORD=

# Каталог проекта на сервере
RIDEAUTO_DEPLOY_REMOTE_ROOT=/opt/rideauto

# Таймаут подключения (сек)
RIDEAUTO_DEPLOY_CONNECT_TIMEOUT=30
