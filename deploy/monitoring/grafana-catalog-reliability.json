{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Search p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wra_http_request_duration_seconds_bucket{path_group=\"/api/search\"}[5m])))",
          "legendFormat": "p95 search",
          "refId": "A"
        }
      ]
    },
    {
      "title": "5xx rate (catalog)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(wra_http_requests_total{status_class=\"5xx\", path_group=~\"/api/(search|car.*|facets).*\"}[5m])) / clamp_min(sum(rate(wra_http_requests_total{path_group=~\"/api/(search|car.*|facets).*\"}[5m])), 1)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Catalog job last success age",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "time() - wra_job_last_completion_unixtime{job=\"wra_catalog_pipeline\"}",
          "legendFormat": "pipeline age s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Meili documents / index empty",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "wra_catalog_meili_documents",
          "legendFormat": "docs",
          "refId": "A"
        },
        {
          "expr": "wra_catalog_index_empty",
          "legendFormat": "empty",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Pricing recompute queue",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "wra_pricing_needs_recompute_rows",
          "legendFormat": "queue",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["rideauto", "catalog"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "RideAuto Catalog Reliability",
  "uid": "rideauto-catalog-reliability",
  "version": 1
}
