[Unit]
Description=RideAuto Auto Update (PostgreSQL)
After=network.target

[Service]
Type=oneshot
User=rideauto
Group=rideauto
WorkingDirectory=/opt/rideauto
Environment=PYTHONUNBUFFERED=1
# Дневной апдейт НЕ гоняет собственный postgres_catalog_sync (~14 ГБ в RAM):
# каталог принадлежит единственному пайплайну rideauto-catalog-pipeline.timer
# (ADR 0004, deploy/docs/SCALE.md).
# Строки стоят ДО EnvironmentFile, чтобы /etc/default/rideauto мог переопределить (SKIP_*=0).
Environment=SKIP_POSTGRES_CATALOG_SYNC=1
Environment=SKIP_FRONTEND_EXPORT=1
# auto_learn_engine_map после postgres_catalog_sync: только при WRA_LEARN_ENGINE_MAP=1 в /etc/default/rideauto.
EnvironmentFile=-/etc/default/rideauto
# Единственный ночной пайплайн Encar для rideauto: discover + sold + encar_scraper --only-pending (см. encar_daily_update.py).
ExecStart=/opt/rideauto/.venv/bin/python /opt/rideauto/backend/encar_daily_update.py --once --config /opt/rideauto/scraper_config.yaml
# Без этого systemd по умолчанию (часто ~90s) убивает длинный scraper до конца цикла.
TimeoutStartSec=24h
# Страховка от утечек в самом скрапере (и на случай SKIP_*=0 в /etc/default/rideauto).
MemoryHigh=3G
MemoryMax=6G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/rideauto
LockPersonality=true
MemoryDenyWriteExecute=true
