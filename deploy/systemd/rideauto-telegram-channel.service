[Unit]
Description=RideAuto Telegram channel autopost (one advantageous listing)
After=network.target docker.service

[Service]
Type=oneshot
User=rideauto
Group=rideauto
WorkingDirectory=/opt/rideauto
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/rideauto
EnvironmentFile=-/opt/rideauto/.env
ExecStart=/opt/rideauto/.venv/bin/python /opt/rideauto/backend/scripts/run_telegram_channel_autopost.py --api http://127.0.0.1:8080 --admin-key ${WRA_CACHE_INVALIDATE_SECRET}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/rideauto
LockPersonality=true
MemoryDenyWriteExecute=true
