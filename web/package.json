{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-static-data": "node scripts/sync-static-data.mjs",
    "dev": "next dev --turbopack",
    "generate:seo-landings": "node ../scripts/generate-seo-landings.mjs",
    "build": "npm run sync-static-data && npm run generate:seo-landings && next build",
    "analyze": "ANALYZE=true next build",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "start": "next start",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:unit": "vitest run",
    "generate:api-types": "openapi-typescript ../docs/openapi.yaml -o src/lib/generated/openapi.ts",
    "generate:api": "npm run generate:api-types"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/browser": "^8.55.0",
    "@sentry/nextjs": "^8.55.2",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "^15.4.10",
    "openapi-fetch": "^0.13.8",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.4.10",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "^15.4.10",
    "openapi-typescript": "^7.6.1",
    "storybook": "8.6.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  }
}
