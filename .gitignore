# Python venv
.venv/
venv/
ENV/

# Node (tailwind и др.; артефакты вроде car-tailwind.css коммитим отдельно)
node_modules/

# Playwright / e2e
test-results/

# Storybook build output
web/storybook-static/

# Ad-hoc одноразовые remote-скрипты с захардкоженными секретами (заменены deploy/ops).
deploy/scripts/_remote_*.py
# Конфиг удалённых операций с реальными секретами (шаблон: deploy/.env.deploy.example)
deploy/.env.deploy

# Временные дампы API на корне (отладка)
/tmp_*.json

# Autorepair agent runtime state
var/autorepair/

# Python / Node tool caches (local only)
