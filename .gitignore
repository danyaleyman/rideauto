che168_scraper.local.yaml

# Server DB dumps (deploy/scripts/backup_postgres_compose.sh)
backups/

# Alertmanager Telegram secrets (копируй из *.example на сервере)
deploy/monitoring/secrets/bot_token
deploy/monitoring/secrets/chat_id
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.log
.cursor/

# Local databases / checkpoints (на сервере своя БД — не коммитить)
*.db
*.db-shm
*.db-wal

# Опциональная статическая выгрузка каталога
web/public/cars.json
web/public/cars.json.gz
web/public/data/cars.index.json
web/public/data/cars.index.json.gz
web/public/data/chunks/*.json
web/public/data/chunks/*.json.gz
